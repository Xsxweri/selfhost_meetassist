# ===== 应用 =====
APP_NAME=Meeting Assistant
DEBUG=True
SQL_ECHO=False
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== 数据库 =====
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=meeting_assistant

# ===== Ollama / LLM =====
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# ===== 提示词 =====
PROMPTS_DIR=prompts

# ===== 运行模式 / ASR =====
RUN_MODE=hybrid
ASR_BACKEND=local
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
ASR_LANGUAGE=
ASR_SAMPLE_RATE=16000
ASR_FLUSH_SECONDS=5

# ===== 云端 ASR（占位）=====
CLOUD_ASR_PROVIDER=
CLOUD_ASR_ENDPOINT=
CLOUD_ASR_API_KEY=

# ===== JWT（生产必须改为强随机值，如 openssl rand -hex 32）=====
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== Redis / Celery =====
REDIS_URL=redis://localhost:6379/0

# ===== 记忆层 =====
CHECKPOINT_BACKEND=memory
MEMORY_ENABLED=True
MEMORY_TOP_K=6
MEMORY_SIM_THRESHOLD=0.82
MEMORY_RECALL_MIN_SIM=0.30
MEMORY_HYBRID=True
THREAD_SUMMARY_THRESHOLD=12